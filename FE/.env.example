# Configuration for GitHub Copilot Metrics Viewer
# This file serves as a template for environment variables.
# Copy this file to .env and fill in your values.

# Determines if mocked data should be used instead of making API calls.
# Set to True for development/testing without GitHub API access
# Set to False for production use
VUE_APP_MOCKED_DATA=False

# Determines the scope of the API calls.
# Options:
# - 'enterprise': Target API calls to a GitHub Enterprise
# - 'organization': Target API calls to a GitHub Organization
VUE_APP_SCOPE=organization

# GitHub Organization or Enterprise Configuration
# Required: Set this to your GitHub organization name
VUE_APP_GITHUB_ORG="your_organization_name"

# Optional: Set this if using enterprise scope
VUE_APP_GITHUB_ENT=

# Optional: Set this to target specific team within organization
VUE_APP_GITHUB_TEAM=

# Vite Configuration (for development)
# These mirror the Vue configuration above
VITE_APP_MOCKED_DATA=False
VITE_APP_SCOPE=organization
VITE_APP_GITHUB_ORG="your_organization_name"
VITE_APP_GITHUB_ENT=

# Security Notes:
# 1. Never commit your actual .env file to version control
# 2. Keep your GitHub Personal Access Token secure
# 3. Use appropriate scopes for your GitHub token:
#    - copilot
#    - manage_billing:copilot or manage_billing:enterprise
#    - read:enterprise
#    - read:org 