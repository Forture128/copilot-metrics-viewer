# Backend Test Environment Configuration
# This file serves as a template for test environment variables.
# Copy this file to .env.test and adjust values as needed.

# Enable backtrace for better debugging
RUST_BACKTRACE=1

# Application Environment
APP_ENV=test

# Server Configuration
APP_SERVER__ADDRESS=0.0.0.0:8080
APP_SERVER__WORKERS=2

# Database Configuration
# Note: These are test database credentials - DO NOT use production credentials
APP_DATABASE__URL=postgres://postgres:postgres@localhost:5432/horus_test
APP_DATABASE__MAX_CONNECTIONS=5
APP_DATABASE__TIMEOUT_SECONDS=30

# Redis Configuration
# Note: This is for local test Redis instance - DO NOT use production Redis
APP_REDIS__URL=redis://127.0.0.1:6379
APP_REDIS__TIMEOUT_SECONDS=30

# Test Database URLs
# These should point to your test database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/horus_test
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/horus_test

# Security Notes:
# 1. Never commit your actual .env.test file to version control
# 2. Use separate test databases for testing
# 3. Never use production credentials in test environment
# 4. Keep test environment isolated from production 